+  /**
+   * Decide the replication to send to the NameNode according to:
+   *  - Respect client explicit settings (-Ddfs.replication or hdfs-site.xml).
+   *  - If nothing explicit is set,
+   *    send -1 so the server-side default is used.
+   */
+  private static short decideReplication(String path, short requestedByCaller, Configuration conf) {
+    boolean clientExplicit = isExplicitlyConfigured(conf, "dfs.replication");
+    short effective;
+
+    if (!clientExplicit) {
+      // No explicit setting anywhere, caller just propagated the default -> send -1
+      effective = (short)-1;
+    } else {
+      // Respect either the explicit config or the caller's explicit value
+      effective = requestedByCaller;
+    }
+    return effective;
+  }
