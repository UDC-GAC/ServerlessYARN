Bootstrap: docker
From: ubuntu:20.04

%files
{% if container_metrics_feeder == 'lite' %}
    "{{ installed_app_directory }}/lite_feeder.c" /opt/lite_feeder/lite_feeder.c
    "{{ installed_app_directory }}/start.sh" /opt/lite_feeder/start.sh
    "{{ installed_app_directory }}/start_tmux.sh" /opt/lite_feeder/start_tmux.sh
{% else %}
    "{{ bdwatchdog_source_path }}" /opt/BDWatchdog
{% endif %}

%environment
    export PLATFORM_SERVER_IP={{ server_ip }}
    export DATA_SERVER_IP={{ data_server_url }}
    export DATA_SERVER_PORT={{ data_server_port }}

%post
    export DEBIAN_FRONTEND=noninteractive

    ## Install apt dependencies
    apt-get -y update

    # Essential
    apt-get -y install tmux git curl
    apt-get install -y --no-install-recommends python3-pip
    apt-get -y install build-essential make

    # Network
    apt-get -y install net-tools iputils-ping traceroute iputils-tracepath bc dnsutils
    #apt-get -y install iptables

    # Other utilities
    apt-get -y install nano

{% if container_metrics_feeder == 'lite' %}
    # Build lite_feeder (no atop nor BDWatchdog in the image)
    gcc -O2 -o /usr/local/bin/lite_feeder /opt/lite_feeder/lite_feeder.c
{% else %}
{% include '../bdw_config/atop_metrics_feeder.j2' %}

{% endif %}

    # Setup regular user and group (same as host to avoid file ownership conflicts)
    USERID={{ user_info.user_id }}
    GROUPID={{ user_info.user_gid }}
    USERNAME={{ user_info.user_name }}
    GROUPNAME={{ user_info.group_name }}
    USERHOME={{ user_home_on_container }}

    # Avoids build failure if the group already exists
    if ! getent group "$GROUPNAME" >/dev/null 2>&1; then
        groupadd -g "$GROUPID" "$GROUPNAME"
    fi

    # Avoids build failure if the user already exists
    if ! id -u "$USERNAME" >/dev/null 2>&1; then
        useradd -d "$USERHOME" -s /bin/bash -u "$USERID" -g "$GROUPID" "$USERNAME"
    fi

%startscript

    # Run metrics feeder as root
{% if container_metrics_feeder == 'lite' %}
    cd /opt/lite_feeder && bash start_tmux.sh
{% else %}
    cd /opt/BDWatchdog/MetricsFeeder && bash scripts/run_atop_stream_tmux.sh
{% endif %}
